{
  "agentic-starter-kits-skills:add-behavioral-tests": {
    "pre": {
      "description": "Skill invocation pre-conditions",
      "assertions": [
        {
          "id": "repo-root",
          "type": "exec",
          "command": "test -f AGENTS.md",
          "on_fail": "warn",
          "description": "Working directory is agentic-starter-kits repo root"
        },
        {
          "id": "agent-dir-exists",
          "type": "exec",
          "command": "test -d agents/${AGENT_PATH}",
          "on_fail": "warn",
          "description": "Agent directory exists under agents/"
        },
        {
          "id": "standard-agent",
          "type": "exec",
          "command": "test -f agents/${AGENT_PATH}/main.py",
          "on_fail": "warn",
          "description": "Agent has main.py (standard agent pattern)"
        },
        {
          "id": "agent-arg",
          "type": "eval",
          "description": "Agent path argument provided and non-empty",
          "pass_if": "First word of skill args contains a / separator (e.g. langgraph/agentic_rag)"
        }
      ]
    },
    "gates": {
      "phase-1-deploy": {
        "description": "Phase 1 deployment gate \u2014 if agent was not already deployed, verify /deploy-agents was used (not manual make deploy)",
        "assertions": [
          {
            "id": "agent-deployed",
            "type": "exec",
            "command": "oc get deployment ${AGENT_NAME} -n ${NAMESPACE} -o name",
            "on_fail": "block",
            "description": "Agent deployment exists in namespace"
          },
          {
            "id": "agent-healthy",
            "type": "exec",
            "command": "curl -sf --max-time 10 https://$(oc get route ${AGENT_NAME} -n ${NAMESPACE} -o jsonpath='{.spec.host}')/health",
            "on_fail": "block",
            "description": "Agent health endpoint returns 200"
          },
          {
            "id": "token-from-secret",
            "type": "exec",
            "command": "oc get deployment ${AGENT_NAME} -n ${NAMESPACE} -o jsonpath='{.spec.template.spec.containers[0].env[?(@.name==\"MLFLOW_TRACKING_TOKEN\")].valueFrom.secretKeyRef.name}'",
            "on_fail": "block",
            "description": "MLFLOW_TRACKING_TOKEN reads from a Kubernetes secret (secretKeyRef), not a hardcoded value. A hardcoded value means /deploy-agents was bypassed \u2014 the Helm chart always wires tokens through secrets. Fix: redeploy via /deploy-agents."
          },
          {
            "id": "tracing-enabled",
            "type": "exec",
            "command": "oc logs deployment/${AGENT_NAME} -n ${NAMESPACE} 2>&1 | grep -q 'Tracing Enabled'",
            "on_fail": "block",
            "description": "Agent startup logs confirm MLflow tracing is enabled (not failed/skipped)"
          },
          {
            "id": "no-hardcoded-tokens-any-agent",
            "type": "eval",
            "description": "No agent in the namespace has a hardcoded MLFLOW_TRACKING_TOKEN value. /deploy-agents Step 4e checks all agents \u2014 if any have hardcoded tokens, /deploy-agents was not run or did not complete Step 4.",
            "pass_if": "For every deployment in the namespace that has MLFLOW_TRACKING_TOKEN, the env var uses valueFrom.secretKeyRef (not a plain value field)"
          }
        ]
      }
    },
    "post": {
      "description": "Scaffolding complete \u2014 all Phases 0-10 artifacts created",
      "assertions": [
        {
          "id": "tests-dir",
          "type": "exec",
          "command": "test -f agents/${AGENT_PATH}/tests/behavioral/conftest.py",
          "on_fail": "block",
          "description": "tests/behavioral/conftest.py exists"
        },
        {
          "id": "golden-queries",
          "type": "exec",
          "command": "test -f agents/${AGENT_PATH}/tests/behavioral/fixtures/golden_queries.yaml",
          "on_fail": "block",
          "description": "golden_queries.yaml fixture exists"
        },
        {
          "id": "evalhub-fixture",
          "type": "exec",
          "command": "test -f agents/${AGENT_PATH}/evalhub/tool_use.yaml",
          "on_fail": "block",
          "description": "EvalHub fixture exists"
        },
        {
          "id": "containerfile-updated",
          "type": "exec",
          "command": "grep -q '${AGENT_SHORT}' evals/evalhub_adapter/Containerfile",
          "on_fail": "block",
          "description": "Containerfile has COPY line for agent"
        },
        {
          "id": "thresholds-updated",
          "type": "exec",
          "command": "grep -q '${AGENT_KEY}' tests/behavioral/configs/thresholds.yaml",
          "on_fail": "block",
          "description": "thresholds.yaml has agent section"
        },
        {
          "id": "run-e2e-updated",
          "type": "exec",
          "command": "grep -q '${AGENT_ROUTE_VAR}' evals/evalhub_adapter/tests/run-e2e.sh",
          "on_fail": "block",
          "description": "run-e2e.sh updated with agent blocks"
        },
        {
          "id": "pytest-marker",
          "type": "exec",
          "command": "grep -q '${AGENT_KEY}' pyproject.toml",
          "on_fail": "block",
          "description": "pyproject.toml has pytest marker for agent"
        },
        {
          "id": "docs-updated",
          "type": "eval",
          "description": "All five documentation files updated per Phase 8",
          "pass_if": "README.md, adding-behavioral-tests.md, adding-evalhub-agent-integration.md, evalhub_adapter/README.md, and agent README all updated with new agent references"
        }
      ]
    }
  }
}
